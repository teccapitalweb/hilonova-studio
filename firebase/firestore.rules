rules_version = '2';

// Cada persona solo puede leer y escribir su propio perfil. Lo demás está cerrado.
// Se pega en la consola de Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name', 'orgName', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 120
                    && request.resource.data.orgName is string && request.resource.data.orgName.size() <= 120;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name', 'orgName', 'createdAt'])
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
