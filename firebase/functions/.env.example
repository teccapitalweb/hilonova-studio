# Copia este archivo como «.env» (en esta misma carpeta) y llena los valores. NO son secretos, pero «.env» no se sube a git.
# Los secretos (llave secreta y firma del webhook de Stripe) NO van aquí: se guardan con «firebase functions:secrets:set».

# Identificador del precio de $490 MXN al mes que creaste en Stripe (empieza con price_)
STRIPE_PRICE_ID=price_PEGA_AQUI

# Opcional: identificador de la tasa de IVA del 16 % creada en Stripe (empieza con txr_). Déjalo vacío si el precio ya incluye IVA.
STRIPE_TAX_RATE_ID=

# Direcciones desde las que se permite pagar (separadas por coma, sin diagonal final). Agrega el dominio final antes de publicar.
ALLOWED_ORIGINS=http://localhost:4321
